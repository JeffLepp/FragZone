[Unit]
Description=FragZone game server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=fragzone
Group=fragzone
WorkingDirectory=/opt/fragzone/server

# setup.sh writes the non-secret origin policy first. Optional secrets or manual
# overrides live in fragzone.env; both files stay root-owned 0600 and out of git.
EnvironmentFile=/etc/fragzone.runtime.env
EnvironmentFile=-/etc/fragzone.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=8080
Environment=METRICS_PORT=8081

ExecStart=/usr/bin/node /opt/fragzone/server/index.js
Restart=on-failure
RestartSec=2
TimeoutStopSec=10

# WebSockets hold one fd per player; the default 1024 is plenty for 8 but this
# costs nothing and removes the ceiling as a variable.
LimitNOFILE=65535

StandardOutput=journal
StandardError=journal
SyslogIdentifier=fragzone

# The app only listens on loopback and touches no files it doesn't ship with.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
SystemCallArchitectures=native
UMask=0077
TasksMax=64
MemoryHigh=256M
MemoryMax=384M

[Install]
WantedBy=multi-user.target
