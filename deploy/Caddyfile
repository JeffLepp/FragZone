# FragZone reverse proxy. Caddy terminates TLS (automatic certificate) and
# proxies to the game server on loopback. FQDN is substituted by setup.sh.
#
# `encode` compresses HTTP responses only — it does not negotiate the
# permessage-deflate WebSocket extension, so gameplay frames stay uncompressed.
# (The app also pins perMessageDeflate:false server-side.)
#
# reverse_proxy passes Upgrade/Connection through natively; no extra config is
# needed for WebSockets.

{$FQDN} {
	encode zstd gzip

	header {
		-Server
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
	}

	# Metrics are for a local load test, never public reconnaissance.
	@metrics path /metrics
	respond @metrics 404

	@bad_methods not method GET HEAD
	respond @bad_methods 405

	reverse_proxy 127.0.0.1:8080 {
		# Gameplay sockets sit idle between bursts and must never be reaped.
		# Caddy has no idle timeout by default; these are explicit so a future
		# global default can't silently kill long-lived matches.
		flush_interval -1
	}
}
